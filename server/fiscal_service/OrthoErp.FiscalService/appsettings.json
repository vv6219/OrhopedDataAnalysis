{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "OrthoErp.FiscalDaemon",
      "Environment": "Production",
      "Version": "2.0.1"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{EventType}] [TID:{ThreadId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/atol-fiscal-.log",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 31,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{EventType}] [PID:{ProcessId}/TID:{ThreadId}] ({Application}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "SqliteDb": "../../../DB/orthopedic_data_center.sqlite"
  },
  "FiscalService": {
    "Port": "COM3",
    "BaudRate": 115200,
    "DeviceModel": "АТОЛ 91Ф",
    "IsMockMode": true,
    "SingleConsumerQueue": true,
    "ExecutionTimeoutSeconds": 35,
    "FnNumber": "9960440301984210",
    "KktRegNumber": "0004928103049182",
    "DefaultTaxType": 6,
    "TaxRegimeName": "Без НДС (пп. 2 п. 2 ст. 149 НК РФ — медицинские услуги)",
    "PaymentSubjectType": 4,
    "PaymentMethodType": 4,
    "DefaultShiftNumber": 14,
    "BaseFiscalDocumentNumber": 1041
  },
  "AllowedHosts": "*"
}